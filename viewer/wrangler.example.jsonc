{
  "name": "outpost-library",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "your-private-bucket"}],
  "observability": {
    "enabled": true,
    "traces": {"enabled": true}
  }
}
